rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /kbrh/choreTracker { allow read, write: if request.auth != null; }
    match /kbrh/staffProfiles {
      allow read: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.token.email == 'admin@kbrh.local' || request.auth.token.email == 'executivedirector@kbrh.local') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profiles']);
      allow create, delete: if false;
    }
    match /kbrh/settings {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.email == 'admin@kbrh.local' || request.auth.token.email == 'executivedirector@kbrh.local');
    }
    match /kbrh/{docId} {
      allow read, write: if request.auth != null && docId != 'staffProfiles' && docId != 'settings';
    }

    // Append-only urine-screen records. Existing legacy roster history is read in the UI.
    match /kbrhUrineScreens/{residentId}/records/{screenId} {
      function screeningStaff() { return request.auth != null && request.auth.token.email in [
        'admin@kbrh.local', 'executivedirector@kbrh.local', 'intakecoordinator@kbrh.local'
      ]; }
      allow get, list: if screeningStaff();
      allow create: if screeningStaff() && request.resource.data.id == screenId &&
        request.resource.data.residentId == residentId &&
        request.resource.data.recordedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Internal staff chat: conversation membership and message access enforced server-side.
    match /kbrhChatConversations/{conversationId} {
      function member() { return request.auth != null && (conversationId == 'staff-wide' || request.auth.uid in resource.data.memberUids); }
      allow get, list: if member();
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.type in ['direct', 'group', 'staffwide'] &&
        request.resource.data.memberUids is list && request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids.size() <= 40 &&
        (conversationId != 'staff-wide' || request.resource.data.type == 'staffwide');
      allow update: if member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastMessageAt','lastSenderUid']) && request.resource.data.lastSenderUid == request.auth.uid;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if request.auth != null && (conversationId == 'staff-wide' || request.auth.uid in get(/databases/$(database)/documents/kbrhChatConversations/$(conversationId)).data.memberUids);
        allow create: if request.auth != null && (conversationId == 'staff-wide' || request.auth.uid in get(/databases/$(database)/documents/kbrhChatConversations/$(conversationId)).data.memberUids) && request.resource.data.senderUid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
      match /reads/{readerUid} {
        allow read, write: if request.auth != null && request.auth.uid == readerUid && (conversationId == 'staff-wide' || request.auth.uid in get(/databases/$(database)/documents/kbrhChatConversations/$(conversationId)).data.memberUids);
      }
    }
    match /kbrhNotifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && resource.data.recipientUid == request.auth.uid;
      allow delete: if false;
    }
    match /kbrhPushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /kbrhRetentionBackups/{backupId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.token.email == 'admin@kbrh.local' || request.auth.token.email == 'executivedirector@kbrh.local');
      allow update, delete: if false;
    }
    match /kbrhAudit/{entryId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.token.email == 'admin@kbrh.local' || request.auth.token.email == 'executivedirector@kbrh.local');
      allow update, delete: if false;
    }
  }
}
