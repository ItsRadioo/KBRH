rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /kbrh/choreTracker { allow read, write: if request.auth != null; }
    match /kbrh/staffProfiles { allow read: if request.auth != null; allow write: if false; }
    match /kbrh/settings {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@kbrh.local';
    }
    match /kbrh/{docId} {
      allow read, write: if request.auth != null && docId != 'staffProfiles' && docId != 'settings';
    }
    match /kbrhAudit/{entryId} { allow read, create: if request.auth != null; allow update, delete: if false; }
  }
}
