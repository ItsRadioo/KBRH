rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every authenticated KBRH staff login can read and update the shared app state,
    // including archiving/restoring residents.
    match /kbrh/choreTracker {
      allow read, write: if request.auth != null;
    }

    // Staff profiles are administered in the Firebase console.
    match /kbrh/staffProfiles {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Any other KBRH document remains available to authenticated staff.
    match /kbrh/{docId} {
      allow read, write: if request.auth != null && docId != 'staffProfiles';
    }

    // Audit entries are append-only for authenticated users.
    match /kbrhAudit/{entryId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
